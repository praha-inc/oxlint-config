    "version:prepublish": "pkg-pr-new publish --pnpm --compact './packages/*'"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@tsconfig/strictest": "2.0.8",
    "oxlint": "1.80.0",
    "pkg-pr-new": "0.0.88",
    "turbo": "2.10.12",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.25.0"
}
